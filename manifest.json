{
	"manifest_version": 2,
	"name": "AniWorld AP [fork]",
	"version": "1.7.0",
	"description": "Skip anime openings and endings on AniWorld using AniSkip - With speed control, next-episode button and auto-play",
	"author": "AniWorld AP",
	"homepage_url": "https://github.com/sioXD/Aniworld-AP",
	"icons": {
		"48": "icons/icon-48.png",
		"96": "icons/icon-96.png"
	},
	"permissions": ["storage", "activeTab", "webNavigation", "<all_urls>", "https://api.aniskip.com/*"],
	"browser_action": {
		"default_icon": {
			"48": "icons/icon-48.png",
			"96": "icons/icon-96.png"
		},
		"default_title": "AniWorld AP [fork]",
		"default_popup": "src/popup.html"
	},
	"content_scripts": [
		{
			"matches": ["*://*.aniworld.to/*", "*://aniworld.to/*"],
			"js": ["src/defaults.js", "src/aniworld.js"],
			"run_at": "document_idle",
			"all_frames": false
		}
	],
	"background": {
		"scripts": ["src/defaults.js", "src/background.js"],
		"persistent": true
	},
	"browser_specific_settings": {
		"gecko": {
			"id": "voe-aniskip-fork@extension",
			"strict_min_version": "142.0",
			"data_collection_permissions": {
				"required": ["personallyIdentifyingInfo", "websiteContent"]
			}
		},
		"gecko_android": {
			"strict_min_version": "142.0"
		}
	},
	"web_accessible_resources": [
		"src/defaults.js",
		"src/content.js",
		"src/styles.css",
		"icons/icon-classic.png",
		"icons/icon-aniworld.png"
	]
}
